# Spotify API credentials
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8080/callback
SPOTIFY_USERNAME=your_spotify_username_here

# Cache database path
SOTD_DB_PATH=./data/sotd_cache.db

# Optional: model weights (override defaults)
SOTD_WEIGHT_NOVELTY=0.35
SOTD_WEIGHT_USER_FIT=0.35
SOTD_WEIGHT_MOOD=0.20
SOTD_WEIGHT_DIVERSITY=0.10
